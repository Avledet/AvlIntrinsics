  <Target Name="DeployMod" AfterTargets="Build">
    <MakeDir Directories="$(MOD_DEPLOYPATH)" Condition="!Exists('$(MOD_DEPLOYPATH)')" />
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(TargetName).dll" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(MOD_DEPLOYPATH)" />
  </Target>

