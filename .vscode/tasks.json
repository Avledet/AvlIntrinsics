{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-release",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "-c", "release"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-debug",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "-c", "debug"],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}